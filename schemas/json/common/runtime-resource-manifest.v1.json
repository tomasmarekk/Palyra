{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palyra.dev/common/runtime-resource-manifest.v1.json",
  "title": "Palyra runtime resource manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_hash", "items"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "manifest_hash": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9:_./+-]+$"
    },
    "items": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "default": []
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "kind",
        "scope",
        "source_scope",
        "provenance",
        "snapshot_hash",
        "required_scopes",
        "collision_behavior"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "prompt",
            "context_snippet",
            "policy_snippet",
            "tool_bundle",
            "artifact_reference"
          ]
        },
        "scope": {
          "type": "string",
          "enum": ["system", "user", "workspace", "project", "session", "run", "temporary"]
        },
        "source_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "snapshot_hash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9:_./+-]+$"
        },
        "required_scopes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true
        },
        "collision_behavior": {
          "type": "string",
          "enum": ["reject", "shadow", "user_wins", "project_wins"]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "resource_id", "kept_source_scope", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kept_source_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dropped_source_scope": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
