{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palyra.dev/common/dynamic-tool-activation-decision.v1.json",
  "title": "Dynamic Tool Activation Decision V1",
  "type": "object",
  "required": [
    "v",
    "activated",
    "tool_name",
    "artifact_sha256",
    "catalog_epoch",
    "approval_generation",
    "rollback_artifact_sha256",
    "descriptor",
    "reason_code"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "activated": {
      "type": "boolean"
    },
    "tool_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$"
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "catalog_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "approval_generation": {
      "type": "integer",
      "minimum": 0
    },
    "rollback_artifact_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "descriptor": {
      "oneOf": [
        {
          "$ref": "#/$defs/descriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "activated": {
            "const": true
          }
        },
        "required": [
          "activated"
        ]
      },
      "then": {
        "properties": {
          "catalog_epoch": {
            "minimum": 1
          },
          "approval_generation": {
            "minimum": 1
          },
          "descriptor": {
            "$ref": "#/$defs/descriptor"
          }
        }
      },
      "else": {
        "properties": {
          "descriptor": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantics": {
      "type": "object",
      "required": [
        "mutating",
        "idempotent",
        "requires_approval",
        "max_execution_ms"
      ],
      "properties": {
        "mutating": {
          "type": "boolean"
        },
        "idempotent": {
          "type": "boolean"
        },
        "requires_approval": {
          "type": "boolean"
        },
        "max_execution_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "additionalProperties": false
    },
    "descriptor": {
      "type": "object",
      "required": [
        "v",
        "tool_name",
        "description",
        "input_schema",
        "output_schema",
        "capabilities",
        "semantics",
        "artifact_sha256",
        "implementation_type"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "tool_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "input_schema": {
          "type": "object",
          "maxProperties": 128
        },
        "output_schema": {
          "type": "object",
          "maxProperties": 128
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          }
        },
        "semantics": {
          "$ref": "#/$defs/semantics"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "implementation_type": {
          "enum": [
            "declarative_composition",
            "wasm_component"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
