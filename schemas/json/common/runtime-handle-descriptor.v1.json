{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palyra.local/common/runtime-handle-descriptor.v1.json",
  "title": "Palyra Runtime Handle Descriptor V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "kind", "generation", "owner", "state", "created_at_unix_ms", "updated_at_unix_ms"],
  "properties": {
    "schema_version": { "const": 1 },
    "instance_id": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["process", "harness", "acp", "mcp", "lsp", "pty", "worker", "plugin"] },
    "session_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "generation": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
    "state": { "enum": ["starting", "running", "draining", "cleaning", "closed", "orphaned", "quarantined"] },
    "resume_metadata_json": { "type": "string", "maxLength": 8192 },
    "created_at_unix_ms": { "type": "integer", "minimum": 0 },
    "updated_at_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128 } },
  "x-palyra-prohibits": ["serialized_live_os_handles", "raw_environment_values", "serialized_pointers"]
}
