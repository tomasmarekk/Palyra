{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palyra.dev/common/pty-session-descriptor.v1.json",
  "title": "Native PTY session descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pty_session_id",
    "owner_id",
    "owner_generation",
    "backend",
    "pid",
    "size",
    "created_at_unix_ms",
    "next_cursor",
    "raw_output_truncated",
    "pty_active"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pty_session_id": { "$ref": "#/$defs/id" },
    "owner_id": { "$ref": "#/$defs/id" },
    "owner_generation": { "$ref": "#/$defs/u64" },
    "backend": {
      "enum": [
        "unix_pty",
        "windows_con_pty"
      ]
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "size": { "$ref": "#/$defs/size" },
    "created_at_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "next_cursor": { "$ref": "#/$defs/u64" },
    "raw_output_truncated": { "type": "boolean" },
    "pty_active": { "type": "boolean" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "dimension": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "cols",
        "pixel_width",
        "pixel_height"
      ],
      "properties": {
        "rows": { "$ref": "#/$defs/dimension" },
        "cols": { "$ref": "#/$defs/dimension" },
        "pixel_width": { "$ref": "#/$defs/dimension" },
        "pixel_height": { "$ref": "#/$defs/dimension" }
      }
    }
  },
  "x-palyra-privacy": {
    "projection": "internal_durable_metadata",
    "forbidden_fields": [
      "argv",
      "environment_values",
      "raw_output",
      "terminal_input"
    ]
  }
}
