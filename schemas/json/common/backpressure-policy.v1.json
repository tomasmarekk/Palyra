{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palyra.local/common/backpressure-policy.v1.json",
  "title": "Palyra Backpressure Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capacity",
    "overflow_action",
    "preserve_terminal",
    "preserve_approval",
    "max_summary_bytes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "overflow_action": {
      "enum": ["block_producer", "coalesce_progress", "spill_metadata_artifact", "reject_producer", "cancel_child"]
    },
    "preserve_terminal": { "const": true },
    "preserve_approval": { "const": true },
    "max_summary_bytes": { "type": "integer", "minimum": 1, "maximum": 8192 }
  },
  "x-palyra-limits": {
    "capacity_max": 65536,
    "summary_bytes_max": 8192
  }
}
