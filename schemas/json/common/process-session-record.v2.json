{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palyra.local/common/process-session-record.v2.json",
  "title": "Palyra Process Session Record V2",
  "description": "Bounded durable metadata for one supervised host process; raw output and environment values are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "process_session_id",
    "owner",
    "command",
    "process_lease",
    "state",
    "created_at_unix_ms",
    "updated_at_unix_ms",
    "deadline_at_unix_ms",
    "no_output_deadline_at_unix_ms",
    "last_output_at_unix_ms",
    "first_retained_cursor",
    "next_cursor",
    "retained_output_bytes",
    "output_truncated",
    "outcome"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "process_session_id": { "$ref": "#/$defs/id" },
    "owner": { "$ref": "#/$defs/owner" },
    "command": { "$ref": "#/$defs/command" },
    "process_lease": { "$ref": "#/$defs/processLease" },
    "state": {
      "enum": [
        "running",
        "draining",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled",
        "cleanup_failed",
        "orphaned"
      ]
    },
    "created_at_unix_ms": { "$ref": "#/$defs/timestamp" },
    "updated_at_unix_ms": { "$ref": "#/$defs/timestamp" },
    "deadline_at_unix_ms": { "$ref": "#/$defs/timestamp" },
    "no_output_deadline_at_unix_ms": {
      "oneOf": [
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "last_output_at_unix_ms": { "$ref": "#/$defs/timestamp" },
    "first_retained_cursor": { "$ref": "#/$defs/u64" },
    "next_cursor": { "$ref": "#/$defs/u64" },
    "retained_output_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4194304
    },
    "output_truncated": { "type": "boolean" },
    "outcome": {
      "oneOf": [
        { "$ref": "#/$defs/outcome" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "maxLength": 64
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "run_id",
        "turn_id",
        "agent_id",
        "correlation_id"
      ],
      "properties": {
        "session_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "turn_id": { "$ref": "#/$defs/id" },
        "agent_id": { "$ref": "#/$defs/id" },
        "correlation_id": { "$ref": "#/$defs/id" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_sha256",
        "executable_label",
        "executable_sha256",
        "redacted_argv_preview",
        "cwd_sha256",
        "environment_key_names",
        "backend"
      ],
      "properties": {
        "command_sha256": { "$ref": "#/$defs/sha256" },
        "executable_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "redacted_argv_preview": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "cwd_sha256": { "$ref": "#/$defs/sha256" },
        "environment_key_names": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "backend": { "const": "managed_stdio" }
      }
    },
    "processLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "lease_id",
        "instance_id",
        "generation",
        "pid",
        "provenance",
        "issued_at_unix_ms",
        "expires_at_unix_ms",
        "verified_at_unix_ms"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "lease_id": { "$ref": "#/$defs/id" },
        "instance_id": { "$ref": "#/$defs/id" },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "issued_at_unix_ms": { "$ref": "#/$defs/timestamp" },
        "expires_at_unix_ms": { "$ref": "#/$defs/timestamp" },
        "verified_at_unix_ms": { "$ref": "#/$defs/timestamp" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership_kind",
        "start_token",
        "executable_sha256",
        "owner_nonce",
        "ownership_identity_sha256"
      ],
      "properties": {
        "ownership_kind": {
          "enum": [
            "unix_process_group",
            "windows_job_object",
            "remote_execution_instance"
          ]
        },
        "start_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "owner_nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ownership_identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "reason_code",
        "completed_at_unix_ms",
        "cleanup_verified"
      ],
      "properties": {
        "exit_code": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            { "type": "null" }
          ]
        },
        "reason_code": { "$ref": "#/$defs/reasonCode" },
        "completed_at_unix_ms": { "$ref": "#/$defs/timestamp" },
        "cleanup_verified": { "type": "boolean" }
      }
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    }
  },
  "x-palyra-limits": {
    "active_sessions_max": 64,
    "retained_chunks_per_session_max": 512,
    "retained_output_bytes_max": 4194304,
    "artifact_bytes_max": 16777216
  },
  "x-palyra-prohibits": [
    "raw_process_output",
    "raw_environment_values",
    "pid_only_authority",
    "serialized_live_os_handles"
  ]
}
