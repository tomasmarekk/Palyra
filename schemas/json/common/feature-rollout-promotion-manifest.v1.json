{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palyra.dev/schemas/common/feature-rollout-promotion-manifest.v1.json",
  "title": "Palyra feature rollout promotion manifest",
  "description": "Release evidence and lifecycle posture for the built-in feature rollout registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "schema_sha256",
    "evidence_profiles",
    "rollouts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "palyra.feature-rollout-promotions.v1"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/evidenceProfile"
      }
    },
    "rollouts": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rollout"
      }
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": ".*\\S.*"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "testRef": {
      "allOf": [
        {
          "$ref": "#/$defs/boundedString"
        }
      ]
    },
    "sli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicator",
        "objective",
        "window"
      ],
      "properties": {
        "indicator": {
          "$ref": "#/$defs/boundedString"
        },
        "objective": {
          "$ref": "#/$defs/boundedString"
        },
        "window": {
          "$ref": "#/$defs/boundedString"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "verification"
      ],
      "properties": {
        "mechanism": {
          "$ref": "#/$defs/boundedString"
        },
        "verification": {
          "$ref": "#/$defs/boundedString"
        }
      }
    },
    "evidenceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_test_refs",
        "sli",
        "rollback",
        "compatibility_commitment",
        "legacy_removal_condition"
      ],
      "properties": {
        "required_test_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/testRef"
          }
        },
        "sli": {
          "$ref": "#/$defs/sli"
        },
        "rollback": {
          "$ref": "#/$defs/rollback"
        },
        "compatibility_commitment": {
          "$ref": "#/$defs/boundedString"
        },
        "legacy_removal_condition": {
          "$ref": "#/$defs/boundedString"
        },
        "direct_hot_path_test_ref": {
          "$ref": "#/$defs/testRef"
        },
        "no_hidden_fallback_test_ref": {
          "$ref": "#/$defs/testRef"
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "owner_component",
        "contract_availability",
        "execution_completeness",
        "promotion_state",
        "support_maturity",
        "lifecycle",
        "evidence_profile",
        "promotion_blockers",
        "removal_condition",
        "shadow_side_effect_posture"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/identifier"
        },
        "owner_component": {
          "$ref": "#/$defs/boundedString"
        },
        "contract_availability": {
          "enum": [
            "descriptor_only",
            "api_available",
            "runtime_available",
            "blocked"
          ]
        },
        "execution_completeness": {
          "enum": [
            "not_implemented",
            "partial",
            "complete"
          ]
        },
        "promotion_state": {
          "enum": [
            "contract_only",
            "shadow",
            "canary",
            "gated_production",
            "stable"
          ]
        },
        "support_maturity": {
          "enum": [
            "unsupported",
            "experimental",
            "preview",
            "supported",
            "deprecated",
            "retired"
          ]
        },
        "lifecycle": {
          "enum": [
            "active",
            "deprecated",
            "retired"
          ]
        },
        "evidence_profile": {
          "$ref": "#/$defs/identifier"
        },
        "promotion_blockers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundedString"
          }
        },
        "replacement": {
          "$ref": "#/$defs/boundedString"
        },
        "removal_date": {
          "type": "string",
          "format": "date"
        },
        "removal_condition": {
          "$ref": "#/$defs/boundedString"
        },
        "shadow_side_effect_posture": {
          "enum": [
            "not_applicable",
            "side_effect_free",
            "not_qualified"
          ]
        }
      }
    }
  }
}
