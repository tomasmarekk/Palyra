        "Authoritative workspace writes return as patch bundles for review"
      ],
      "requires_attestation": true,
      "requires_egress_proxy": true,
      "workspace_scope_mode": "workspace_scoped_container_mount",
      "artifact_transport": "container_patch_bundle_transfer",
      "cleanup_strategy": "container_and_volume_removal_attestation"
    },
    {
      "backend_id": "local_sandbox",
      "label": "Local sandbox",
      "description": "Run work on the daemon host and keep sandbox/process-runner guardrails local.",
      "executor_label": "sandbox_tier_b",
      "rollout_flag": null,
      "rollout_enabled": true,
      "tradeoffs": [
        "Most conservative default posture",
        "Cannot satisfy first-party desktop-native capability requests by itself"
      ],
      "requires_attestation": false,
      "requires_egress_proxy": false,
      "workspace_scope_mode": "daemon_workspace_root",
      "artifact_transport": "direct_local_filesystem",
      "cleanup_strategy": "process_exit_and_workspace_scope_validation"
    },
    {
      "backend_id": "networked_worker",
      "label": "Networked worker",
      "description": "Run work on an attested ephemeral worker with proxy-mediated egress and scoped artifact transport.",
      "executor_label": "networked_worker",
      "rollout_flag": "PALYRA_EXPERIMENTAL_EXECUTION_BACKEND_NETWORKED_WORKER",
      "rollout_enabled": false,
      "tradeoffs": [
        "Requires explicit worker attestation plus cleanup verification before use",
        "Worker leases stay ephemeral with ttl<=900000ms and fail closed on cleanup gaps"
      ],
      "requires_attestation": true,
      "requires_egress_proxy": true,
      "workspace_scope_mode": "ephemeral_scoped_mount",
      "artifact_transport": "manifest_attested_bundle_transfer",
      "cleanup_strategy": "lease_ttl_reap_with_fail_closed_cleanup"
    },
