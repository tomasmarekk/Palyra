      "requires_egress_proxy": false,
      "workspace_scope_mode": "paired_node_workspace_contract",
      "artifact_transport": "node_rpc_transfer",
      "cleanup_strategy": "node_disconnect_or_run_completion_cleanup"
    },
    {
      "backend_id": "docker",
      "label": "Docker",
