  "required_subsystems": [
    {
      "id": "session_queue_policy",
      "summary": "Queued input lifecycle naming, states, and follow-up acceptance coverage."
    },
    {
      "id": "pruning_policy_matrix",
      "summary": "Pruning and compaction preview contracts stay stable before runtime rollout widens."
    },
    {
      "id": "retrieval_dual_path",
      "summary": "Dual-path retrieval diagnostics and degraded recall posture remain explicit."
    },
    {
      "id": "replay_capture",
      "summary": "Replay-oriented checkpoint and capture fixtures stay serializable before full replay runtime lands."
    },
    {
      "id": "auxiliary_executor",
      "summary": "Delegated child execution fixtures remain stable for future merge and lineage work."
    },
    {
      "id": "flow_orchestration",
      "summary": "Flow transition lifecycle coverage remains wired before durable orchestration expands."
    },
    {
      "id": "delivery_arbitration",
      "summary": "Delivery policy and audit-only override behavior remain regression-tested."
    },
    {
      "id": "networked_workers",
      "summary": "Networked worker preview inventory, lifecycle, and degrade posture stay fail-closed."
    },
    {
      "id": "agentic_regression_matrix",
      "summary": "Agentic behavior scenarios stay covered with fake providers, fake external services, and actionable failure report fields."
    },
    {
      "id": "harness_path_runtime",
      "summary": "Local agent process and OS file tools keep unrestricted OS access, container/runtime path arguments, and strict-mode fallbacks regression-tested."
    },
    {
      "id": "harness_tool_output_streaming",
      "summary": "Tool output bounds, foreground progress events, binary handling, and Windows text decoding remain model-safe and diagnosable."
    },
    {
      "id": "harness_resume_state",
      "summary": "Auto-resume checkpoints preserve produced/missing artifacts, failed attempts, and background process state across runtime interruptions."
    },
    {
      "id": "harness_run_loop_recovery",
      "summary": "Run-stream phase watchdogs keep post-tool provider turns from stalling silently after agent-loop turn start."
    },
    {
      "id": "harness_background_handoff",
      "summary": "Background process launchers, run-owned cleanup, and durable detached service handoff stay explicit."
    },
    {
      "id": "harness_runtime_risk_posture",
      "summary": "Process risk metadata surfaces Docker, package-manager, credential, and target-runtime mismatch side effects without blocking out-of-box execution."
    },
    {
      "id": "harness_workspace_recovery",
      "summary": "Malformed patch recovery and workspace-root selection keep file tools anchored to explicit agent roots."
    },
    {
      "id": "harness_redaction_image_observation",
      "summary": "Public fixture redaction and image observation avoid false secret positives, large base64 payloads, and OCR workaround loops."
    }
  ],
