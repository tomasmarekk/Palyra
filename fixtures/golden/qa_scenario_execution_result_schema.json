{
  "artifact_reference": {
    "path": "relative_no_parent_components",
    "sha256": "lowercase_hex_64",
    "size_bytes": "u64",
    "write_policy": "create_new_no_overwrite"
  },
  "artifact_reference_base": "qa_gate_report.artifact_reference_base",
  "cleanup_fields": [
    "run_terminal_observed",
    "session_cleaned",
    "daemon_terminated",
    "workspace_removed",
    "verified",
    "reason_codes"
  ],
  "excluded_payloads": [
    "raw_transcript",
    "raw_tape",
    "provider_secrets",
    "absolute_paths"
  ],
  "format": "palyra-qa-scenario-execution-result",
  "optional_runtime_fields": [
    "run_id",
    "session_id",
    "terminal_state"
  ],
  "required_fields": [
    "schema_version",
    "format",
    "execution_id",
    "scenario_id",
    "runner_mode",
    "verdict",
    "reason_codes",
    "evidence_artifacts",
    "cleanup"
  ],
  "schema_version": 1
}
